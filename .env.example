# Local speech service defaults. Copy to .env and edit as needed.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SPEECH_PORT=8000
MAX_AUDIO_BYTES=20971520
MAX_CONCURRENT_INFERENCES=1
SPEECH_UPSTREAM_TIMEOUT_SECONDS=90
SPEECH_ALLOWED_ORIGINS=https://horacech.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# Optional cloud providers. Keep secrets only in this untracked local .env file.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Independent GPU Compose settings (CPU Compose always uses cpu).
WHISPER_GPU_MODEL_SIZE=small
WHISPER_GPU_COMPUTE_TYPE=float16
MAX_CONCURRENT_REQUESTS=1
UPLOAD_TIMEOUT_SECONDS=30

# Optional immutable Hugging Face model revision for reproducible evaluation.
WHISPER_MODEL_REVISION=

# Docker Compose 2.24+ also reads optional untracked .env.model for text services.
# Configure GEMINI_API_KEY and OPENAI_API_KEY above. Other built-in providers
# use <PROVIDER>_API_KEY in .env.model. Model overrides use <PROVIDER>_TEXT_MODELS
# (comma-separated allowlist) and <PROVIDER>_TEXT_MODEL (default). Custom trusted
# upstreams use TEXT_PROVIDER_CONFIG_JSON in .env.model. Never use VITE_ for keys.
